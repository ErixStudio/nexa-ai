# ==========================================
# NEXA AI PHP Backend Environment Configuration
# Place this file as .env in your backend root directory or one level above public_html
# ==========================================

APP_ENV=production
APP_DEBUG=false

# OTP Email Verification Rules
OTP_ENABLED=true
OTP_EXPIRY_MINUTES=10

# SMTP Email Delivery (cPanel Port 465 SSL)
MAIL_ENABLED=true
MAIL_HOST=mail.hamyarstar.shop
MAIL_PORT=465
MAIL_USERNAME=nexaai@hamyarstar.shop
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=ssl
MAIL_FROM=nexaai@hamyarstar.shop
MAIL_FROM_NAME=NEXA AI

# MySQL / MariaDB Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=h410448_NEXAAI
DB_USER=h410448_admin
DB_PASSWORD=YOUR_SECURE_MYSQL_PASSWORD

# Google Gemini API
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-pro-preview

# JWT Authentication Security
JWT_SECRET=SUPER_SECURE_RANDOM_LONG_SECRET_KEY_NEXA_AI_2026
JWT_EXPIRES_IN=604800
REFRESH_TOKEN_EXPIRES_IN=2592000

# Business Logic & CORS
FREE_ANALYSIS_LIMIT=3
CORS_ORIGIN=*

# Myket In-App Billing (IAB) Configuration
MYKET_PACKAGE_NAME=com.aistudio.nexaai.trading
MYKET_API_KEY=YOUR_MYKET_DEVELOPER_API_KEY
MYKET_PUBLIC_KEY=YOUR_MYKET_RSA_PUBLIC_KEY

