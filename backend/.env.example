# ==========================================
# NEXA AI Backend Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=production

# MySQL / MariaDB Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=h410448_NEXAAI
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Security & JWT Tokens
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_KEY
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Business & Rate Limit Settings
FREE_ANALYSIS_LIMIT=3

# CORS Origin (Use * for all, or domain: https://yourdomain.com)
CORS_ORIGIN=*

# OTP Verification System (Set true to enforce email OTP on register)
OTP_ENABLED=false
OTP_EXPIRY_MINUTES=10
